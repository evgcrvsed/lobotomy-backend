# Глобальные настройки Caddy (пусто — берём значения по умолчанию).
# Нужен, чтобы файл не начинался сразу с адреса сайта в фигурных скобках.
{
}

# Точка входа. Если SITE_DOMAIN — домен, Caddy сам получит и продлит
# сертификат Let's Encrypt и включит HTTPS. Значение ":80" — работа по HTTP.
{$SITE_DOMAIN} {
	# Ограничение по IP: реальный адрес клиента виден здесь, на входе.
	# По умолчанию 0.0.0.0/0 ::/0 — открыто всем. В .env: ALLOWED_IP=твой.ip
	@blocked not remote_ip {$ALLOWED_IP:0.0.0.0/0 ::/0}
	respond @blocked "Access denied" 403

	# Всё остальное — на наш nginx (он отдаёт сайт и проксирует API/статику)
	reverse_proxy frontend:80
}
